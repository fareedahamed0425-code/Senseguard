# SenseGuard Frontend Configuration

# The WebSocket URL for the Python backend. 
# In local development/Electron, this defaults to ws://127.0.0.1:8000/ws/telemetry
# For the web version, set this to your hosted backend URL (e.g., Render or Railway)
VITE_WS_URL=wss://your-senseguard-backend.onrender.com/ws/telemetry

# The REST API URL for the Python backend (for status checks)
VITE_BACKEND_URL=https://your-senseguard-backend.onrender.com
